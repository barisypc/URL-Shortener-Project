# --- services/url_service.py -------------------------------------------

def test_detect_client_platform_pc():
    platform, browser = detect_client_platform(_fake_request(PC_UA))
    assert platform == "PC"
    assert browser == "Chrome"


def test_detect_client_platform_mobile():
    platform, _ = detect_client_platform(_fake_request(IPHONE_UA))
    assert platform == "Mobile"


def test_detect_client_platform_tablet():
    platform, _ = detect_client_platform(_fake_request(IPAD_UA))
    assert platform == "Tablet"


def test_detect_client_platform_unknown_agent():
    platform, browser = detect_client_platform(_fake_request(""))
    assert platform == "Other"
    assert isinstance(browser, str)


def test_generate_qr_base64_returns_data_uri():
    data_uri = generate_qr_base64("http://testserver/abc123")
    assert data_uri.startswith("data:image/png;base64,")
    assert len(data_uri) > 100